{
  "domain": {
    "type": "cube",
    "side_length": 1.0,
    "random_seed": 42
  },
  "network": {
    "mode": "tree",
    "target_terminal_count": 4,
    "root": {
      "start": [0.49, -0.49, -0.49],
      "direction": [-0.49, 0.49, 0.49]
    }
  },
  "growth": {
    "n_closest_vessels": 2,
    "n_points": 50,
    "ignore_collisions": true,
    "allow_inside_vessels": true,
    "n_equal_bifurcations": 2,
    "equal_terminal": {
      "batch_size": 100,
      "length": 0.05,
      "length_shrink": 0.5,
      "report_timings": false
    }
  },
  "simulation": {
    "fluid": "blood",
    "build_fluid": "blood",
    "qin_target_ul_min": 900.0,
    "concentration_solver": "topdown",
    "distance_sample_count": 0,
    "geometry_only": true
  },
  "outputs": {
    "out_dir": "gfm_run_tree_equal_smoke",
    "prefix": "cube_tree_equal",
    "write_paraview": true,
    "save_network": true
  }
}
