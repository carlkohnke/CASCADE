# Explicit allowlist for the Python source distribution (sdist).
include README.md LICENSE
include pyproject.toml setup_env.py
recursive-include requirements *.txt *.md *.yml
include docs/architecture.md docs/custom-geometry.md docs/gui.md docs/known-issues.md docs/svv-compatibility.md docs/windows-qualification.md
recursive-include src/cascade/gui/assets *.svg
recursive-include src/cascade/gui/native *.cs
recursive-include src/cascade/gui/shaders *.frag *.vert
recursive-include src/cascade/assets/domains *.stl
recursive-include src/cascade/assets/numerics *.npz
recursive-include src/cascade/accelerators/cuda *.cu *.cuh
global-exclude *.py[cod] __pycache__
