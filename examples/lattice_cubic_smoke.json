{
  "schema_version": 1,
  "domain": {
    "type": "cube",
    "side_length": 1.0,
    "random_seed": 42
  },
  "network": {
    "mode": "simple",
    "target_terminal_count": 1,
    "simple": {
      "mode": "lattice",
      "lattice_type": "cubic",
      "cells": 1,
      "radius_cm": 0.005,
      "subdivisions": 1,
      "flow_ul_min": 10.0
    }
  },
  "growth": {
    "enabled": false,
    "n_closest_vessels": 2,
    "n_points": 50
  },
  "simulation": {
    "fluid": "blood",
    "build_fluid": "blood",
    "qin_target_ul_min": 10.0,
    "concentration_solver": "network",
    "distance_sample_count": 0,
    "geometry_only": true
  },
  "settings": {
    "hemodynamics": {
      "kirchhoff_solver": "spsolve",
      "kirchhoff_bc_mode": "terminal_pressure"
    },
    "oxygen": {
      "lumen_wall_closure": "wellmixed"
    }
  },
  "outputs": {
    "out_dir": ".gfm_gui_test/lattice_cubic_smoke",
    "prefix": "lattice_cubic_smoke",
    "write_summary_csv": true,
    "write_segments_csv": false,
    "write_points_csv": false,
    "write_paraview": false,
    "save_network": false
  },
  "gui": {
    "project_name": "Cubic lattice smoke",
    "network_source": "lattice",
    "boundary_conditions": {
      "mode": "flow_pressure",
      "pressure_unit": "mmHg",
      "flow_unit": "µL/min"
    },
    "sweeps": []
  }
